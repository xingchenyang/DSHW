<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
  
    <RootNamespace>DSHW.Desktop</RootNamespace>
  
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\logo.ico</ApplicationIcon>
  
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <!-- 默认语言 en-US：法语/中文系统走对应 .resw，其他语言系统回退英语 -->
    <DefaultLanguage>en-US</DefaultLanguage>

    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  
    <!-- 版本信息（右键 exe → 属性 → 详细信息） -->
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <Product>DSHW</Product>
    <AssemblyTitle>DSHW</AssemblyTitle>
    <Description>DSHW - DSH Workbench for Windows</Description>
    <Company>xingchenyang</Company>
    <Authors>xingchenyang</Authors>
    <Copyright>Copyright © 2026 xingchenyang</Copyright>
  
    <!-- 发布配置见 Properties\PublishProfiles\（full / single / lite） -->
    <PublishProfile>full.pubxml</PublishProfile>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <PropertyGroup>
    <!-- 发布输出目录不参与 SDK 默认内容/None 扫描（否则会被打包进单文件 exe，导致体积膨胀+嵌套）。
         注意：DefaultItemExcludes 是属性，不是 ItemGroup！ -->
    <DefaultItemExcludes>$(DefaultItemExcludes);release\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <!-- 拆分包（不用 Microsoft.WindowsAppSDK 元包，避免拖入 AI/ML/Search/Widgets 等未使用库，显著减小发布体积）
         版本需与 Runtime 2.4.0 的组件期望一致（见 Microsoft.WindowsAppSDK.ComponentReference.targets） -->
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" Version="2.3.9" />
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.3.6" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="2.4.0" />
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="2.1.6" />
    <PackageReference Include="Microsoft.WindowsAppSDK.DWrite" Version="2.1.0" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2526" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4129.50" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.11" />
    <PackageReference Include="System.Text.Json" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Assets\logo.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Unpackaged 模式约定：MRT Core 期望 exe 旁存在 resources.pri -->
  <Target Name="CopyPriAsResourcesPri" AfterTargets="Build">
    <Copy SourceFiles="$(TargetDir)$(AssemblyName).pri"
          DestinationFiles="$(TargetDir)resources.pri"
          SkipUnchangedFiles="true" />
  </Target>

  <!-- 发布（dotnet publish 文件夹版）时也会复制 pri，否则 WinUI 启动崩溃（XAML 资源缺失） -->
  <Target Name="CopyPriToPublish" AfterTargets="Publish">
    <Copy SourceFiles="$(TargetDir)$(AssemblyName).pri"
          DestinationFolder="$(PublishDir)"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(TargetDir)$(AssemblyName).pri"
          DestinationFiles="$(PublishDir)resources.pri"
          SkipUnchangedFiles="true" />
  </Target>
</Project>