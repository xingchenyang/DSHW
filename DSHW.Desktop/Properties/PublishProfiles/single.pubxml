<?xml version="1.0" encoding="utf-8"?>
<!--
Lite 单文件版（WinAppSDK 自包含）：单个 exe，内嵌 Windows App SDK，仅依赖目标机已安装 .NET 9 Runtime。
体积约 100-140MB（介于完全版与 Lite 文件夹版之间）。
-->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <PublishProtocol>FileSystem</PublishProtocol>
    <Platform>x64</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- 用 MSBuildThisFileDirectory（本文件目录，绝对）避免 profile 导入早期 ProjectDir 未展开导致路径错乱 -->
    <PublishDir>$(MSBuildThisFileDirectory)..\..\release\single\</PublishDir>
    <DeleteExistingFiles>true</DeleteExistingFiles>
    <SelfContained>false</SelfContained>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableMsixTooling>true</EnableMsixTooling>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>
</Project>
