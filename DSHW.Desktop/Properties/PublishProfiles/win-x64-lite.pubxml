<?xml version="1.0" encoding="utf-8"?>
<!--
Lite 版（FDD，框架依赖）：体积小，适合本机 / 已安装运行时的机器。
目标机要求：.NET 9 Runtime + Windows App SDK Runtime + WebView2 Runtime。
完全版（SCD 单文件）见 win-x64.pubxml。
-->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <PublishProtocol>FileSystem</PublishProtocol>
    <Platform>x64</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishDir>bin\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\publish-lite\</PublishDir>
    <SelfContained>false</SelfContained>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <PublishSingleFile>false</PublishSingleFile>
  </PropertyGroup>
</Project>
