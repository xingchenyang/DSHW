<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="DSHW.Desktop.InstallGuideWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="">
    <Grid Padding="24" RowSpacing="12" MaxWidth="620">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="TitleText"
                   FontSize="18" FontWeight="SemiBold" Foreground="#1A1A1A"
                   TextWrapping="Wrap"/>

        <TextBlock Grid.Row="1" x:Name="DescText"
                   FontSize="12" Foreground="#444444" TextWrapping="Wrap"/>

        <!-- 命令预览（只读，可选中复制） -->
        <StackPanel Grid.Row="2" Spacing="6">
            <TextBox x:Name="CommandBox" IsReadOnly="True"
                     FontFamily="Consolas" FontSize="12"
                     TextWrapping="Wrap" MinHeight="48"/>

            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Stretch">
                <CheckBox x:Name="MirrorCheck" Content="npmmirror (镜像)"
                          VerticalAlignment="Center"
                          Checked="OnMirrorToggled" Unchecked="OnMirrorToggled"/>
                <TextBox x:Name="MirrorInput" Text="https://registry.npmmirror.com"
                         Visibility="Collapsed" Width="200" FontSize="12"
                         VerticalAlignment="Center"
                         PlaceholderText="https://registry.npmmirror.com"/>
                <ToggleSwitch x:Name="VerboseSwitch"
                              Header="完整日志 (verbose)"
                              OffContent="" OnContent=""
                              MinWidth="150" VerticalAlignment="Center"
                              Toggled="OnVerboseToggled"/>
            </StackPanel>
        </StackPanel>

        <!-- 安装进度日志（实时滚动；可选中/复制） -->
        <Border Grid.Row="4" Background="#1E1E1E" CornerRadius="4"
                BorderBrush="#333333" BorderThickness="1" MinHeight="140" Margin="0,4,0,4">
            <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto"
                          Padding="8">
                <TextBox x:Name="LogBox" IsReadOnly="True"
                         Background="Transparent" BorderThickness="0"
                         Foreground="#D4D4D4" FontFamily="Consolas" FontSize="11"
                         TextWrapping="NoWrap"/>
            </ScrollViewer>
        </Border>

        <!-- 操作按钮 -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="10"
                    HorizontalAlignment="Right">
            <Button x:Name="CopyBtn" Click="OnCopyClick"/>
            <Button x:Name="InstallBtn" Click="OnInstallClick"/>
            <Button x:Name="RecheckBtn" Click="OnRecheckClick"/>
            <Button x:Name="CloseBtn" Click="OnCloseClick"/>
        </StackPanel>
    </Grid>
</Window>
